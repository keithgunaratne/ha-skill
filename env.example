# Base URL of your Home Assistant API
HA_URL=http://127.0.0.1:8123
# Long-lived access token (Profile -> Long-Lived Access Tokens -> Create Token)
HA_TOKEN=replace_with_manually_created_long_lived_access_token
# Absolute path to your HA config dir on the host (bind-mounted into the container)
HA_CONFIG_DIR=/path/to/your/homeassistant
# Name of the Home Assistant Docker container
HA_CONTAINER=homeassistant
