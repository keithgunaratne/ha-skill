#!/bin/sh
# Restart the Home Assistant Docker container.
# Workflow: validate config → confirm → restart → tail logs.

SKILL_BIN="$(cd "$(dirname "$0")" && pwd)"
SKILL_DIR="$(cd "$SKILL_BIN/.." && pwd)"
ENV_FILE="$SKILL_DIR/.env"

if [ ! -f "$ENV_FILE" ]; then
  echo "ERROR: .env not found at $ENV_FILE" >&2
  exit 1
fi

# shellcheck disable=SC1090
. "$ENV_FILE"

if [ -z "$HA_CONTAINER" ]; then
  echo "ERROR: HA_CONTAINER is not set in $ENV_FILE" >&2
  exit 1
fi

# Step 1: validate config
echo "==> Step 1/3: Validating configuration..."
if ! "$SKILL_BIN/ha-check-config"; then
  echo ""
  echo "ERROR: Config validation failed. Fix errors before restarting." >&2
  exit 1
fi

echo ""
echo "==> Config validation passed."

# Step 2: explicit confirmation
echo ""
printf "WARNING: This will restart the '%s' container. HA will be unavailable briefly.\n" "$HA_CONTAINER"
printf "Type YES to continue: "
read -r CONFIRM

if [ "$CONFIRM" != "YES" ]; then
  echo "Restart cancelled."
  exit 0
fi

# Step 3: restart
echo ""
echo "==> Step 2/3: Restarting container '$HA_CONTAINER'..."
docker restart "$HA_CONTAINER"

echo ""
echo "==> Step 3/3: Waiting 10 seconds for startup, then showing logs..."
sleep 10
"$SKILL_BIN/ha-logs" 50
